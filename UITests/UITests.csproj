<Project Sdk="Microsoft.NET.Sdk">

  <!-- Автоматизированные UI-тесты приложения «Управление музыкальной коллекцией» (ЛР №6).
       FlaUI 5 для .NET Framework поставляется под net48, поэтому проект тестов собирается под .NET Framework 4.8.
       Тестируемое приложение (LR_№1.exe) собирается перед тестами — см. ProjectReference ниже. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UITests</RootNamespace>
    <AssemblyName>UITests</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Только порядок сборки: сборка приложения в тесты не подключается, оно запускается как отдельный процесс -->
    <ProjectReference Include="..\LR_№1\LR_№6.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
